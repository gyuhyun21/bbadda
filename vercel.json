{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/game/arcade",
      "destination": "/game/",
      "permanent": false
    },
    {
      "source": "/game/arcade/",
      "destination": "/game/",
      "permanent": false
    },
    {
      "source": "/games",
      "destination": "/game/",
      "permanent": false
    },
    {
      "source": "/games/",
      "destination": "/game/",
      "permanent": false
    }
  ],
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_REF\" in daily/*|claude/*|insta-media) exit 0;; *) exit 1;; esac"
}
