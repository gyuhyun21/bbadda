{
  "name": "bbadda",
  "version": "0.1.0",
  "description": "BBADDA(빠따닷컴) — KBO 팀별 소식 매거진",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "collect": "node scripts/run.mjs scripts/collect/index.ts",
    "validate": "tsx scripts/validate.ts",
    "enrich": "node scripts/run.mjs scripts/enrich.ts",
    "test": "tsx --test tests/*.test.ts",
    "clear-sample": "tsx scripts/clear-sample.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "astro": "^7.3.8",
    "fast-xml-parser": "^5.11.2",
    "pagefind": "^1.5.2",
    "tsx": "^4.23.15",
    "web-push": "^3.6.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
