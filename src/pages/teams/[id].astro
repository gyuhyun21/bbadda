---
import Layout from '../../components/Layout.astro';
import SignalCard from '../../components/SignalCard.astro';
import SignalList from '../../components/SignalList.astro';
import TeamChip from '../../components/TeamChip.astro';
import ShareButton from '../../components/ShareButton.astro';
import { MODULE_LABEL, SLANG_TITLE, TEAMS, loadAll, ofTeam, recent, hot, newest, teamColor, teamLogo, daysOf, onDay, dayLabel, UPDATED_LABEL } from '../../lib/site.ts';
import type { Team } from '../../lib/config.ts';
export function getStaticPaths() { return TEAMS.map((t) => ({ params: { id: t.id }, props: { team: t } })); }
const { team: t } = Astro.props as { team: Team };
const data = await loadAll();
const mine = ofTeam(data.signals, t.id);
const latest = recent(mine.filter((s) => (s.module === 'team' || s.module === 'rivalry') && !s.official), 7);
const official = mine.filter((s) => s.official).sort(newest).slice(0, 12);
const fans = recent(mine.filter((s) => s.module === 'fans'), 14).sort(hot);
const slang = [...new Map(mine.filter((s) => s.slang).map((s) => [s.slang!, s])).values()];
const teamDays = daysOf(mine);
---
<Layout title={t.name} description={latest[0] ? `오늘의 ${t.short}: ${latest[0].title_ko ?? latest[0].title}` : `${t.name} 최근 소식, 공식 영상, 팬 반응`} image={`/og/${t.id}.png`} sample={mine.some((s) => s.sample)}>
  <section class="team-hero" style={`--team:${teamColor(t.id)}`}>
    <p class="eyebrow">{t.city} · KBO 리그</p>
    <h1 class="page-title">{teamLogo(t.id) && <img class="team-hero-logo" src={teamLogo(t.id)} alt="" width="64" height="64" />}{t.name}</h1>
    <div class="team-hero-actions" data-pagefind-ignore>
      <button type="button" class="team-chip team-chip--btn" data-pick-team={t.id} data-color={teamColor(t.id)} data-name={t.name} data-short={t.short}>★ 내 팀으로</button>
      <ShareButton />
      {t.website && <a class="small" href={t.website} target="_blank" rel="noopener noreferrer">공식 웹사이트</a>}
      {t.youtube && <a class="small" href={t.youtube} target="_blank" rel="noopener noreferrer">공식 YouTube</a>}
      {t.instagram && <a class="small" href={t.instagram} target="_blank" rel="noopener noreferrer">공식 Instagram</a>}
    </div>
  </section>

  {official.length > 0 && (
    <section class="block official-block" aria-labelledby="h-official-team">
      <div class="block-head"><h2 id="h-official-team">오피셜</h2><span class="small">{t.name} 공식 YouTube·Instagram</span></div>
      <div class="row-cards">{official.map((s) => <SignalCard signal={s} showModule={false} />)}</div>
    </section>
  )}

  <section class="block" aria-labelledby="h-latest">
    <div class="block-head"><h2 id="h-latest">최근 소식</h2><span class="small">{UPDATED_LABEL}</span></div>
    {latest.length ? <div class="grid">{latest.slice(0, 8).map((s) => <SignalCard signal={s} />)}</div> : <p class="empty-hint">아직 소식이 없습니다.</p>}
    <SignalList signals={latest.slice(8)} label="이 밖의 소식" />
  </section>


  <section class="block" aria-labelledby="h-fans">
    <div class="block-head"><h2 id="h-fans">{MODULE_LABEL.fans}</h2><span class="small">YouTube·커뮤니티, 최근 2주</span></div>
    {fans.length ? <SignalList signals={fans} /> : <p class="empty-hint">아직 팬 반응이 없습니다.</p>}
    {slang.length > 0 && (
      <div class="slang-box">
        <p class="eyebrow">수집된 글에 쓰인 은어</p>
        <div class="slang-chips">{slang.map((s) => <a class="chip chip--slang" href={s.url} target="_blank" rel="noopener noreferrer" title={SLANG_TITLE}>{s.slang}</a>)}</div>
      </div>
    )}
  </section>

  {teamDays.length > 0 && (
    <section class="block" aria-labelledby="h-team-days" data-pagefind-ignore>
      <div class="block-head"><h2 id="h-team-days">날짜별</h2></div>
      <ul class="day-chips">{teamDays.slice(0, 14).map((d) => <li><a href={`/days/${d}/#team-${t.id}`}><strong>{dayLabel(d)}</strong><span class="small">{onDay(mine, d).length}건</span></a></li>)}</ul>
    </section>
  )}
  <p class="small other-teams">다른 팀: {TEAMS.filter((x) => x.id !== t.id).map((x) => <TeamChip id={x.id} short href={`/teams/${x.id}`} />)}</p>
</Layout>
