---
// 게임 고르기: 휴대폰 머리말 '게임' 알약이 여기로 온다(머리말에 알약 3개가 안 들어가서). 두 게임 모두 테스트판, 검색 노출 차단은 각 게임 파일에 있다
import Layout from '../components/Layout.astro';
const games = [
  { href: '/game/', name: '매니저 게임', tag: '감독', desc: '타순·작전·투수 교체를 정하고 시즌을 치르는 문자중계 야구 매니저', how: '터치·마우스로 고르기' },
  { href: '/game/arcade/', name: '아케이드 야구', tag: '선수', desc: '포수 뒤 시점에서 직접 치고 던지는 8비트 도트 야구', how: '휴대폰은 가로로 들고 터치 · PC는 방향키 + A S D F' },
];
---
<Layout title="게임" description="빠따닷컴 야구 게임 두 가지: 매니저 게임과 아케이드 야구(테스트판)" searchable={false}>
  <div class="games-page">
    <h1 class="page-title">게임</h1>
    <p class="games-note">둘 다 테스트판. 선수 이름은 모두 가상이고, 기록은 이 기기 브라우저에만 저장됨.</p>
    <ul class="games-list">
      {games.map((g) => (
        <li>
          <a href={g.href} class="games-card">
            <span class="games-tag">{g.tag}</span>
            <strong>{g.name}</strong>
            <span class="games-desc">{g.desc}</span>
            <span class="games-how">{g.how}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Layout>
<style>
  .games-page { max-width: 640px; margin: 0 auto; }
  .games-note { color: var(--muted, #6b7280); font-size: 0.92rem; }
  .games-list { list-style: none; padding: 0; display: grid; gap: 14px; }
  .games-card { display: grid; gap: 6px; padding: 18px 20px; border-radius: 18px; background: var(--card, #fff); color: inherit; text-decoration: none; box-shadow: 5px 5px 12px rgba(166, 178, 196, 0.45), -5px -5px 12px rgba(255, 255, 255, 0.9); }
  .games-card strong { font-size: 1.15rem; }
  .games-tag { justify-self: start; font-size: 0.78rem; font-weight: 800; padding: 3px 10px; border-radius: 999px; background: #CFE9D6; color: #1D1D1F; }
  li:nth-child(2) .games-tag { background: #CFE3F5; }
  .games-desc { line-height: 1.5; }
  .games-how { font-size: 0.85rem; color: var(--muted, #6b7280); }
  .games-card:focus-visible { outline: 3px solid var(--accent, #F2C300); outline-offset: 2px; }
</style>
