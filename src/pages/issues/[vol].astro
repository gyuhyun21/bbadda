---
import Layout from '../../components/Layout.astro';
import IssueView from '../../components/IssueView.astro';
import { loadAll, issueLabel } from '../../lib/site.ts';
export async function getStaticPaths() {
  const data = await loadAll();
  return data.issues.map((issue) => ({ params: { vol: issue.vol }, props: { issue } }));
}
const { issue } = Astro.props;
---
<Layout title={issueLabel(issue.vol)} sample={issue.sample}><IssueView issue={issue} /></Layout>
