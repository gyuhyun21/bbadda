---
import SignalCard from './SignalCard.astro';
import SignalList from './SignalList.astro';
import TeamSection from './TeamSection.astro';
import CommunitySection from './CommunitySection.astro';
import IssueNav from './IssueNav.astro';
import { communitySection } from '../lib/config.ts';
import { MODULE_LABEL, TEAMS, loadAll, issueSignals, fmtDate, shortTitle, hot, displayTitle, issueLabel, periodLabel, rich, teamName } from '../lib/site.ts';
import type { Issue } from '../lib/schemas.ts';
interface Props { issue: Issue }
const { issue } = Astro.props;
const data = await loadAll();
const signals = issueSignals(data, issue.vol);
const cover = issue.cover_signals.map((id) => data.byId.get(id)).filter((s) => s !== undefined);
const league = signals.filter((s) => s.module === 'league').sort(hot);
const rivalry = signals.filter((s) => s.module === 'rivalry').sort(hot);
const prev = data.issues.filter((i) => i.vol !== issue.vol).slice(0, 6);
// 팀 순서: 이번 호 소식이 많은 팀 먼저(내 팀은 화면에서 맨 위로 옮긴다)
const teamOrder = [...TEAMS].sort((a, b) => signals.filter((s) => s.teams.includes(b.id)).length - signals.filter((s) => s.teams.includes(a.id)).length);
---
<IssueNav issue={issue} issues={data.issues} where="top" />

<section class="masthead" aria-label="마스트헤드" data-pagefind-meta={`title:${issueLabel(issue.vol)} · ${periodLabel(issue.period_start, issue.period_end)}`}>
  <h1>BBADDA <em>Weekly</em></h1>
  <p class="issue-title"><strong>{issueLabel(issue.vol)}</strong><span class="issue-period">{periodLabel(issue.period_start, issue.period_end)}</span></p>
  <div class="masthead-top"><span>발행 {fmtDate(issue.published_at)}</span><span>소식 {signals.length}건</span></div>
</section>

{cover.length > 0 && (
  <section class="block" aria-labelledby="h-cover">
    <div class="block-head">
      <h2 id="h-cover">Headline</h2>
      <div class="carousel-ctrl"><button class="btn" type="button" data-carousel-prev aria-label="이전">←</button><button class="btn" type="button" data-carousel-next aria-label="다음">→</button></div>
    </div>
    <div class="carousel-wrap"><div class="carousel" data-carousel tabindex="0" aria-label="이번 주 헤드라인">
      {cover.map((s) => <SignalCard signal={s!} big />)}
    </div></div>
  </section>
)}

<section class="block" aria-labelledby="h-brief">
  <div class="block-head"><h2 id="h-brief">Editor's Brief</h2></div>
  <div class="brief">
    {issue.brief.map((b, n) => (
      <div class="brief-item">
        <div class="meta"><span class="eyebrow">0{n + 1}</span> {b.team && <span class="chip">{teamName(b.team)}</span>}</div>
        <p>{b.text}</p>
        <div class="evidence">
          {b.evidence.map((id) => { const s = data.byId.get(id); return s ? <a href={s.url} target="_blank" rel="noopener noreferrer">↗ {shortTitle(displayTitle(s), 26)}</a> : null; })}
        </div>
      </div>
    ))}
  </div>
</section>

<section class="block league" id="league" aria-labelledby="h-league">
  <div class="block-head"><h2 id="h-league">{MODULE_LABEL.league}</h2></div>
  <div class="module">
    <aside class="module-side">
      <h3>KBO 리그</h3>
      <p class="small">제도·일정·중계·흥행, 순위 경쟁</p>
      {issue.editorial.league && <div class="module-text rich" set:html={rich(issue.editorial.league)} />}
    </aside>
    <div class="module-main">
      {league.length > 0 && <div class="grid module-grid">{league.slice(0, 4).map((s) => <SignalCard signal={s} showModule={false} />)}</div>}
      <SignalList signals={league.slice(4)} label={`이 밖의 ${MODULE_LABEL.league}`} />
      <SignalList signals={rivalry} label={MODULE_LABEL.rivalry} />
      {league.length + rivalry.length === 0 && <p class="empty-hint">이번 호에는 리그 전체 소식이 없습니다.</p>}
    </div>
  </div>
</section>

<section class="block teams" id="teams" aria-labelledby="h-teams">
  <div class="block-head"><h2 id="h-teams">팀별 소식</h2><span class="small">내 팀을 고르면 맨 위에 펼쳐집니다</span></div>
  <div class="team-sections" data-team-sort>
    {teamOrder.map((t) => <TeamSection id={t.id} signals={signals} editorial={issue.editorial.teams[t.id]} />)}
  </div>
</section>

{communitySection() && <CommunitySection signals={signals} note={issue.editorial.community} />}

<IssueNav issue={issue} issues={data.issues} where="bottom" />

{prev.length > 0 && (
  <section class="block" aria-labelledby="h-prev" data-pagefind-ignore>
    <div class="block-head"><h2 id="h-prev">지난 호</h2><a href="/archive">전체 보기 →</a></div>
    {prev.map((i) => <a class="issue-row" href={`/issues/${i.vol}`}><strong>{issueLabel(i.vol)}</strong><span>{periodLabel(i.period_start, i.period_end)}</span><span class="small">{fmtDate(i.published_at)}</span></a>)}
  </section>
)}

<script>
  // 캐러셀: 버튼, 2.5초마다 한 장씩, 마우스 올리면 멈춤, 직접 조작하면 6초 쉼, 화면 밖·'동작 줄이기'면 멈춤
  const car = document.querySelector<HTMLElement>('[data-carousel]');
  const step = (dir: number) => car?.scrollBy({ left: dir * car.clientWidth * 0.8, behavior: 'smooth' });
  document.querySelector('[data-carousel-prev]')?.addEventListener('click', () => step(-1));
  document.querySelector('[data-carousel-next]')?.addEventListener('click', () => step(1));
  if (car && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let hover = false, visible = false, pausedUntil = 0;
    const hold = (ms = 6000) => { pausedUntil = Date.now() + ms; };
    car.addEventListener('pointerenter', () => (hover = true));
    car.addEventListener('pointerleave', () => (hover = false));
    ['pointerdown', 'wheel', 'touchstart', 'focusin', 'keydown'].forEach((t) => car.addEventListener(t, () => hold(), { passive: true }));
    document.querySelectorAll('[data-carousel-prev], [data-carousel-next]').forEach((b) => b.addEventListener('click', () => hold()));
    new IntersectionObserver(([e]) => (visible = e.isIntersecting), { threshold: 0.3 }).observe(car);
    const advance = () => {
      const max = car.scrollWidth - car.clientWidth;
      if (max <= 0) return;
      if (car.scrollLeft >= max - 4) { car.scrollTo({ left: 0, behavior: 'smooth' }); return; }
      const base = car.getBoundingClientRect().left;
      const next = ([...car.children] as HTMLElement[]).find((c) => c.getBoundingClientRect().left - base > 4);
      car.scrollTo({ left: next ? Math.min(max, car.scrollLeft + next.getBoundingClientRect().left - base) : max, behavior: 'smooth' });
    };
    setInterval(() => { if (visible && !hover && !document.hidden && Date.now() >= pausedUntil) advance(); }, 2500);
  }
</script>
