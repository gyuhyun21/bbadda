---
// 첫 화면 'front'(매일 바뀌는 스포츠 1면). config/site.yaml home: simple 로 바꾸면 이전 화면(팀 선택 + 최근 소식 격자).
import SignalCard from './SignalCard.astro';
import SignalList from './SignalList.astro';
import TeamChip from './TeamChip.astro';
import TeamPicker from './TeamPicker.astro';
import CommunitySection from './CommunitySection.astro';
import { communitySection, newsImages } from '../lib/config.ts';
import { TEAMS, loadAll, ofTeam, recent, hot, newest, kstDay, daysOf, onDay, dayLabel, seasonTitle, displayTitle, fmtDate, teamColor, isToday, youtubeId, BUILD_TIME } from '../lib/site.ts';
const data = await loadAll();
const all = data.signals;
const fresh = recent(all, 2, 12);
// 1) 헤드라인: 최근 2일 점수 상위 — 사진 있는 기사를 대표로
const ranked = [...fresh].filter((s) => s.module !== 'fans').sort(hot);
const lead = (newsImages() ? ranked.find((s) => s.image) : undefined) ?? ranked[0];
const side = ranked.filter((s) => s !== lead).slice(0, 4);
// 3) 10개 구단 한눈에
const today = kstDay(new Date(BUILD_TIME).toISOString());
const tiles = TEAMS.map((t) => {
  // 그 팀 단독 소식(팀 소식) 먼저, 라이벌 기사는 뒤로 — 두 팀 타일에 같은 기사가 대표로 겹치지 않게
  const mine = recent(ofTeam(all, t.id).filter((s) => s.module !== 'fans'), 3).sort((a, b) => Number(a.module !== 'team') - Number(b.module !== 'team'));
  return { t, top: mine[0], more: mine.slice(1, 3), today: ofTeam(all, t.id).filter(isToday).length, official: ofTeam(all, t.id).filter((s) => s.official && isToday(s)).length };
});
// 4) 리그(시즌에 따라 제목이 바뀐다)
const league = recent(all.filter((s) => s.module === 'league' || s.module === 'rivalry'), 3).sort(hot);
// 5) 오피셜 영상
const officialVideos = all.filter((s) => s.official && s.source_type === 'youtube').sort(newest).slice(0, 12);
// 6) 팬 반응
const fans = recent(all.filter((s) => s.module === 'fans'), 7).sort(hot).slice(0, 12);
// 7) 날짜별 소식(최근 7일)
const days = daysOf(all).slice(0, 7);
---
<section class="front-masthead" aria-label="BBADDA">
  <p class="eyebrow">{dayLabel(today)} · 매일 아침 갱신</p>
  <h1 class="sr-only">BBADDA 빠따닷컴</h1>
</section>

{lead && (
  <section class="block front-headline" aria-labelledby="h-headline">
    <div class="block-head"><h2 id="h-headline">오늘의 헤드라인</h2></div>
    <div class="headline-grid">
      <div class="headline-lead"><SignalCard signal={lead} big /></div>
      <ul class="headline-side">
        {side.map((s) => {
          const yt = s.source_type === 'youtube' ? youtubeId(s.url) : undefined;
          const thumb = yt ? `https://i.ytimg.com/vi/${yt}/mqdefault.jpg` : newsImages() ? s.image : undefined;
          return (
            <li class={thumb ? 'has-thumb' : ''}>
              {thumb && <a class="headline-thumb" href={s.url} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true"><img src={thumb} alt="" loading="lazy" referrerpolicy="no-referrer" width="160" height="120" onerror="this.parentElement.remove()" /></a>}
              <span class="headline-meta">{s.teams.slice(0, 2).map((t) => <TeamChip id={t} short />)} {s.official && <span class="chip chip--official">오피셜</span>}</span>
              <a class="headline-title" href={s.url} target="_blank" rel="noopener noreferrer">{displayTitle(s)}</a>
              <span class="headline-sum">{s.summary_ko}</span>
              <span class="headline-src">{s.source_name} · {fmtDate(s.published_at)}</span>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
)}

<TeamPicker />
{TEAMS.map((t) => {
  const list = recent(ofTeam(all, t.id), 7).slice(0, 8);
  return (
    <section class="block myteam-now" data-myteam-block={t.id} aria-label={`${t.name} 최근 소식`}>
      <div class="block-head"><h2><TeamChip id={t.id} /> 내 팀 소식</h2><a href={`/teams/${t.id}`}>팀 페이지 →</a></div>
      {list.length ? <div class="row-cards">{list.map((s) => <SignalCard signal={s} />)}</div> : <p class="empty-hint">아직 {t.name} 소식이 없습니다.</p>}
    </section>
  );
})}

<section class="block front-teams" aria-labelledby="h-teams-glance">
  <div class="block-head"><h2 id="h-teams-glance">10개 구단 한눈에</h2><a href="/teams">팀 전체 →</a></div>
  <ul class="team-tiles">
    {tiles.map(({ t, top, more, today, official }) => (
      <li class="team-tile" style={`--team:${teamColor(t.id)}`} data-team-tile={t.id}>
        <a class="team-tile-head" href={`/teams/${t.id}`}>
          <TeamChip id={t.id} />
          <span class="small">{today > 0 ? `오늘 ${today}건` : '오늘 소식 없음'}{official > 0 ? ` · 오피셜 ${official}` : ''}</span>
        </a>
        {top ? (
          <a class="team-tile-top" href={top.url} target="_blank" rel="noopener noreferrer">
            {newsImages() && top.image && <img src={top.image} alt="" loading="lazy" referrerpolicy="no-referrer" width="160" height="100" onerror="this.remove()" />}
            <span>{displayTitle(top)}</span>
          </a>
        ) : <p class="small">최근 소식이 없습니다.</p>}
        {more.length > 0 && <ul class="team-tile-more">{more.map((s) => <li><a href={s.url} target="_blank" rel="noopener noreferrer">{displayTitle(s)}</a></li>)}</ul>}
      </li>
    ))}
  </ul>
</section>

<section class="block team-rail-block" aria-labelledby="h-team-rail">
  {/* 구단 레일(layout: soft) — 이니셜 배지 10개, 누르면 그 구단 최근 소식이 아래에 바뀐다. 다른 레이아웃은 위 타일을 쓴다 */}
  <div class="block-head"><h2 id="h-team-rail">구단별 소식</h2><a href="/teams">모든 구단</a></div>
  <div class="team-rail" role="tablist" aria-label="구단 선택">
    {tiles.map(({ t, today }, n) => (
      <button type="button" role="tab" class="team-badge" id={`rail-tab-${t.id}`} data-rail-team={t.id} aria-controls={`rail-panel-${t.id}`} aria-selected={n === 0 ? 'true' : 'false'} style={`--team:${teamColor(t.id)}`}>
        <span class="team-badge-mark" aria-hidden="true">{t.short}</span>
        <span class="team-badge-name">{t.name}</span>
        <span class="team-badge-count">{today > 0 ? `오늘 ${today}` : '—'}</span>
      </button>
    ))}
  </div>
  {tiles.map(({ t, top, more }, n) => {
    const list = [top, ...more].filter((x) => x !== undefined);
    return (
      <div class="team-rail-panel" role="tabpanel" id={`rail-panel-${t.id}`} aria-labelledby={`rail-tab-${t.id}`} data-rail-panel={t.id} hidden={n > 0}>
        {list.length ? (
          <ul class="rail-list">
            {list.map((s) => {
              const yt = s.source_type === 'youtube' ? youtubeId(s.url) : undefined;
              const thumb = yt ? `https://i.ytimg.com/vi/${yt}/mqdefault.jpg` : newsImages() ? s.image : undefined;
              return (
                <li>
                  {thumb && <img src={thumb} alt="" loading="lazy" referrerpolicy="no-referrer" width="160" height="90" onerror="this.remove()" />}
                  <div>
                    <a href={s.url} target="_blank" rel="noopener noreferrer">{displayTitle(s)}</a>
                    <p>{s.summary_ko}</p>
                    <span>{s.official ? '오피셜 · ' : ''}{s.source_name} · {fmtDate(s.published_at)}</span>
                  </div>
                </li>
              );
            })}
          </ul>
        ) : <p class="empty-hint">최근 {t.name} 소식이 없습니다.</p>}
        <a class="rail-more" href={`/teams/${t.id}`}>{t.name} 소식 모두 보기</a>
      </div>
    );
  })}
</section>

{league.length > 0 && (
  <section class="block front-league" aria-labelledby="h-season">
    <div class="block-head"><h2 id="h-season">{seasonTitle()}</h2><span class="small">리그 전체·라이벌·순위 경쟁</span></div>
    <div class="grid">{league.slice(0, 4).map((s) => <SignalCard signal={s} />)}</div>
    <SignalList signals={league.slice(4, 12)} />
  </section>
)}

{officialVideos.length > 0 && (
  <section class="block official-block" aria-labelledby="h-official-videos">
    <div class="block-head"><h2 id="h-official-videos">오피셜 영상</h2><span class="small">구단·KBO 공식 YouTube</span></div>
    <div class="row-cards">{officialVideos.map((s) => <SignalCard signal={s} showModule={false} />)}</div>
  </section>
)}

{fans.length > 0 && (
  <section class="block" aria-labelledby="h-fans-front">
    <div class="block-head"><h2 id="h-fans-front">팬 반응</h2><span class="small">팬 영상·블로그·카페, 최근 7일</span></div>
    <SignalList signals={fans} />
  </section>
)}
{communitySection() && <CommunitySection signals={recent(all.filter((s) => s.source_type === 'community'), 14)} />}

{days.length > 0 && (
  <section class="block front-days" aria-labelledby="h-days" data-pagefind-ignore>
    <div class="block-head"><h2 id="h-days">날짜별 소식</h2><a href="/archive">전체 날짜 →</a></div>
    <ul class="day-chips">
      {days.map((d) => <li><a href={`/days/${d}/`}><strong>{dayLabel(d)}</strong><span class="small">{onDay(all, d).length}건</span></a></li>)}
    </ul>
  </section>
)}

<script>
  // 구단 레일: 누르면 그 구단 패널만 보인다. 처음에는 내 팀(있으면)을 고른다. 좌우 화살표로도 이동.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-rail-team]')];
  const select = (id: string, focus = false) => {
    tabs.forEach((b) => {
      const on = b.dataset.railTeam === id;
      b.setAttribute('aria-selected', String(on));
      b.tabIndex = on ? 0 : -1;
      if (on && focus) b.focus();
    });
    document.querySelectorAll<HTMLElement>('[data-rail-panel]').forEach((p) => (p.hidden = p.dataset.railPanel !== id));
  };
  tabs.forEach((b, i) => {
    b.addEventListener('click', () => select(b.dataset.railTeam!));
    b.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
      select(next.dataset.railTeam!, true);
    });
  });
  const mine = document.documentElement.dataset.myTeam;
  if (mine && tabs.some((b) => b.dataset.railTeam === mine)) select(mine);
  else if (tabs[0]) select(tabs[0].dataset.railTeam!);
</script>
