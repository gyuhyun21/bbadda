---
// 팀 칩 10개 — 누르면 내 팀으로 저장(Layout 스크립트가 data-pick-team 을 처리)
import { TEAMS } from '../lib/site.ts';
import TeamPickChip from './TeamPickChip.astro';
---
<div class="team-picker" data-no-team>
  <p class="team-picker-q">MY팀은 어디인가요?</p>
  <div class="team-picker-chips">
    {TEAMS.map((t) => <TeamPickChip t={t} />)}
  </div>
</div>
