---
// 가을야구 대진(첫 화면 맨 위) — MLB.com 포스트시즌 브래킷·ESPN 시리즈 카드 방식.
// 위: 다음 경기(예고 선발) + 그 시리즈 일정. 아래: 라운드 카드 한 줄, 누르면 경기별 기록(선발·승패·세이브·홀드·홈런·관중)이 펼쳐진다.
// 데이터: data/postseason.yaml(일정: KBO 발표, 결과·기록: 수집된 기사로 확인한 것만). 끄기: config/site.yaml postseason_bracket: false
import { loadPostseason, resolvePostseason, type Side, type GameView } from '../lib/postseason.ts';
import { teamById, teamColor, teamLogo, BUILD_TIME } from '../lib/site.ts';
const data = loadPostseason();
const today = new Date(BUILD_TIME + 9 * 3600_000).toISOString().slice(0, 10);
const view = data ? resolvePostseason(data, today) : null;
const name = (s: Side) => (s.id ? teamById.get(s.id)?.short ?? s.id : s.label);
const color = (s: Side) => (s.id ? teamColor(s.id) : '#C7CBD3');
const md = (g: GameView) => `${Number(g.date.slice(5, 7))}.${Number(g.date.slice(8, 10))}(${g.weekday})`;
const when = (g: GameView) => `${g.date === today ? '오늘' : `${Number(g.date.slice(5, 7))}월 ${Number(g.date.slice(8, 10))}일 (${g.weekday})`} ${g.time}`;
const champion = view?.rounds.at(-1)?.winner;
const nextRound = view?.next && view.rounds.find((r) => r.id === view.next!.round);
// 점수는 이긴 팀 기준 "LG 4-1 두산"
const scoreLine = (g: GameView) => {
  if (!g.score) return '';
  const [a, b] = g.score.split('-').map(Number);
  const [w, l] = a >= b ? [0, 1] : [1, 0];
  return `${name(g.sides[w])} ${Math.max(a, b)}-${Math.min(a, b)} ${name(g.sides[l])}`;
};
// 승·패·세이브 투수 옆 구단명: 승·세이브는 이긴 팀, 패는 진 팀. 홀드는 데이터에 '이름(팀)'으로 적는다
const sidesOf = (g: GameView) => { const [a, b] = (g.score ?? '0-0').split('-').map(Number); return a >= b ? [g.sides[0], g.sides[1]] : [g.sides[1], g.sides[0]]; };
const withTeam = (p: string | undefined, s: Side) => (p ? (/\(/.test(p) ? p : `${p}(${name(s)})`) : '');
const hostOf = (u: string) => { try { return new URL(u).hostname.replace(/^(www|m)\./, ''); } catch { return '기사'; } };
---
{view && (
  <section class="block ps-block" aria-labelledby="h-postseason" data-pagefind-ignore>
    <div class="block-head"><h2 id="h-postseason">{data!.season} 가을야구</h2></div>
    <div class="ps-wrap">
      {view.next && nextRound ? (
        <div class="ps-next">
          <div class="ps-next-main">
            <div class="ps-next-head">
              <div>
                <p class="ps-next-label">{view.next.date === today ? '오늘 경기' : '다음 경기'}</p>
                <p class="ps-next-round">{view.next.roundName} {view.next.no}차전</p>
              </div>
              <p class="ps-next-when"><strong>{when(view.next)}</strong><span>{view.next.venue}</span></p>
            </div>
            <div class="ps-next-teams">
              {view.next.sides.map((s, i) => (
                <>
                  {i === 1 && <span class="ps-vs">vs</span>}
                  <span class="ps-team">
                    <span class={`ps-mark${s.id && teamLogo(s.id) ? ' has-logo' : ''}`} style={`--team:${color(s)}`}>{s.id && teamLogo(s.id) ? <img class="team-logo" src={teamLogo(s.id)} alt="" width="46" height="46" /> : name(s)}</span>
                    <span class="ps-wins">{name(s)} {s.wins}승</span>
                    {view.next!.record.starters[i] && <span class="ps-starter">선발 <strong>{view.next!.record.starters[i]}</strong>{view.next!.record.starterNotes[i] && <em>{view.next!.record.starterNotes[i]}</em>}</span>}
                  </span>
                </>
              ))}
            </div>
            {view.next.sides.every((s) => s.id) && (
              /* 승부 예측(api/vote) — 한 줄. 저장소가 연결되지 않았거나 실패하면 숨긴다 */
              <div class="ps-vote" data-vote={`${view.next.round}${view.next.no}-${view.next.date}-${view.next.sides[0].id}-${view.next.sides[1].id}`} hidden>
                <p class="ps-vote-q">승부 예측 <span>누가 이길까요?</span></p>
                <div class="ps-vote-btns">
                  {view.next.sides.map((s) => <button type="button" class="ps-vote-btn" data-vote-team={s.id} style={`--team:${color(s)}`} aria-label={`${name(s)} 승리 예측`}>{name(s)} 승</button>)}
                </div>
                <div class="ps-vote-result" hidden>
                  <span class="ps-vote-pct">{name(view.next.sides[0])} <strong data-vote-pct={view.next.sides[0].id}>0%</strong></span>
                  <span class="ps-vote-bar">{view.next.sides.map((s) => <span data-vote-bar={s.id} style={`--team:${color(s)}`}></span>)}</span>
                  <span class="ps-vote-pct"><strong data-vote-pct={view.next.sides[1].id}>0%</strong> {name(view.next.sides[1])}</span>
                </div>
                <p class="ps-vote-note" data-vote-note data-close={view.next.time}></p>
              </div>
            )}
          </div>
          {view.next.record.facts.length > 0 && (
            <div class="ps-points">
              <p class="ps-points-title">관전 포인트</p>
              <ul>{view.next.record.facts.map((f) => <li>{f}</li>)}</ul>
            </div>
          )}
          <div class="ps-sched">
            <p class="ps-sched-title">{nextRound.name} 일정 <span>{nextRound.toWin}선승</span></p>
            <ol class="ps-sched-list">
              {nextRound.games.map((g) => (
                <li class={`${g === view.next ? 'is-next' : ''}${g.played ? ' is-played' : ''}${g.skipped ? ' is-skipped' : ''}`}>
                  <span class="ps-sched-no">{g.no}차전</span>
                  <span class="ps-sched-date">{md(g)} {g.time}</span>
                  <span class="ps-sched-venue">{g.venue}</span>
                  <span class="ps-sched-state">{g.played ? scoreLine(g) : g.skipped ? '열리지 않음' : g === view.next ? (g.date === today ? '오늘' : '다음 경기') : g.ifNeeded ? '미확정' : ''}</span>
                </li>
              ))}
            </ol>
          </div>
        </div>
      ) : champion ? (
        <div class="ps-next"><div class="ps-next-main"><p class="ps-next-label">우승</p><div class="ps-next-teams"><span class="ps-team"><span class={`ps-mark${teamLogo(champion) ? ' has-logo' : ''}`} style={`--team:${teamColor(champion)}`}>{teamLogo(champion) ? <img class="team-logo" src={teamLogo(champion)} alt="" width="46" height="46" /> : teamById.get(champion)?.short}</span></span></div><p class="ps-next-when"><strong>{teamById.get(champion)?.name}</strong> {data!.season} 한국시리즈 우승</p></div></div>
      ) : null}
      <ol class="ps-rounds">
        {view.rounds.map((r) => {
          const played = r.games.filter((g) => g.played);
          const inner = (
            <>
              <span class="ps-round-name">{r.name}<span>{r.toWin}선승</span></span>
              {r.sides.map((s) => (
                <span class={`ps-side${r.winner && s.id === r.winner ? ' is-winner' : ''}${r.winner && s.id !== r.winner ? ' is-out' : ''}`}>
                  {s.id && teamLogo(s.id) ? <img class="ps-logo" src={teamLogo(s.id)} alt="" width="22" height="22" /> : <span class="ps-dot" style={`--team:${color(s)}`}></span>}
                  <span class="ps-side-name">{name(s)}</span>
                  <span class="ps-side-wins">{r.status === 'upcoming' && !s.wins ? '' : s.wins}</span>
                </span>
              ))}
              <span class="ps-round-foot">
                {r.winner ? `${teamById.get(r.winner)?.short} 진출` : r.next ? `${r.next.no}차전 ${md(r.next)} ${r.next.time} ${r.next.venue}` : '일정 확인 중'}
                {played.length > 0 && <span class="ps-round-more">경기 기록</span>}
              </span>
            </>
          );
          return (
            <li class={`ps-round is-${r.status}`}>
              {played.length > 0
                ? <button type="button" class="ps-round-btn" data-ps-round={r.id} aria-expanded="false" aria-controls={`ps-rec-${r.id}`}>{inner}</button>
                : <div class="ps-round-btn">{inner}</div>}
            </li>
          );
        })}
      </ol>
      {view.rounds.filter((r) => r.games.some((g) => g.played)).map((r) => (
        <div class="ps-records" id={`ps-rec-${r.id}`} hidden>
          <p class="ps-records-title">{r.name} 경기 기록</p>
          {r.games.filter((g) => g.played).map((g) => {
            const rec = g.record;
            const rows: [string, string][] = [
              ['선발', g.sides.map((s, i) => (rec.starters[i] ? `${rec.starters[i]}(${name(s)})` : '')).filter(Boolean).join(' · ')],
              ['승리', withTeam(rec.win, sidesOf(g)[0])], ['패전', withTeam(rec.loss, sidesOf(g)[1])], ['세이브', withTeam(rec.save, sidesOf(g)[0])], ['홀드', rec.holds.join(', ')],
              ['홈런', rec.homers.join(', ')], ['MVP', rec.mvp ?? ''], ['관중', rec.attendance ?? ''],
            ];
            return (
              <article class="ps-game">
                <p class="ps-game-head"><strong>{g.no}차전</strong> {md(g)} · {g.venue}<span class="ps-game-score">{scoreLine(g)}</span></p>
                <dl class="ps-game-rec">{rows.filter(([, v]) => v).map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>
              </article>
            );
          })}
        </div>
      ))}
    </div>
    <details class="ps-sources">
      <summary>출처</summary>
      <p>일정: <a href={data!.schedule_source} target="_blank" rel="noopener noreferrer">KBO 발표 일정 보도</a></p>
      {view.rounds.flatMap((r) => r.games.filter((g) => g.record.sources.length).map((g) => (
        <p>{r.short} {g.no}차전: {g.record.sources.map((u, i) => <>{i > 0 && ', '}<a href={u} target="_blank" rel="noopener noreferrer">{hostOf(u)}</a></>)}</p>
      )))}
    </details>
  </section>
)}
<script>
  // 승부 예측: 결과 보기는 누구나, 투표는 경기 시작 전까지 기기당 1번(서버는 IP당 1표)
  document.querySelectorAll<HTMLElement>('[data-vote]').forEach(async (box) => {
    const game = box.dataset.vote!;
    const key = `bbadda:vote:${game}`;
    let mine: string | null = null;
    try { mine = localStorage.getItem(key); } catch {}
    const show = (d: { counts: Record<string, number>; open: boolean }) => {
      const total = Object.values(d.counts).reduce((a, b) => a + b, 0);
      box.querySelectorAll<HTMLElement>('[data-vote-bar]').forEach((el) => { const n = d.counts[el.dataset.voteBar!] ?? 0; el.style.flexGrow = String(total ? n : 1); });
      box.querySelectorAll<HTMLElement>('[data-vote-pct]').forEach((el) => { const n = d.counts[el.dataset.votePct!] ?? 0; el.textContent = `${total ? Math.round((n / total) * 100) : 0}%`; });
      const note = box.querySelector<HTMLElement>('[data-vote-note]')!;
      // 참여 인원은 표시하지 않고 비율만. 투표 전에는 사용법 한 줄
      note.textContent = !d.open ? '투표 마감' : mine ? `내 예측: ${box.querySelector<HTMLElement>(`[data-vote-team="${mine}"]`)?.textContent ?? ''} · 경기 시작 전까지 비율이 바뀌어요` : `${note.dataset.close} 마감`;
      const voted = !!mine || !d.open;
      box.querySelector<HTMLElement>('.ps-vote-btns')!.hidden = voted;
      box.querySelector<HTMLElement>('.ps-vote-result')!.hidden = !voted;
      
      box.hidden = false;
    };
    try {
      const r = await fetch(`/api/vote?game=${encodeURIComponent(game)}`);
      if (!r.ok) return;
      show(await r.json());
    } catch { return; }
    box.querySelectorAll<HTMLButtonElement>('[data-vote-team]').forEach((b) => b.addEventListener('click', async () => {
      box.querySelectorAll<HTMLButtonElement>('[data-vote-team]').forEach((x) => (x.disabled = true));
      try {
        const r = await fetch('/api/vote', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ game, team: b.dataset.voteTeam }) });
        const d = await r.json();
        if (d.counts) { mine = b.dataset.voteTeam!; try { localStorage.setItem(key, mine); } catch {} show(d); }
      } catch {} finally { box.querySelectorAll<HTMLButtonElement>('[data-vote-team]').forEach((x) => (x.disabled = false)); }
    }));
  });
  // 라운드 카드를 누르면 그 라운드의 경기 기록을 펼친다(한 번에 하나)
  document.querySelectorAll<HTMLButtonElement>('[data-ps-round]').forEach((b) => b.addEventListener('click', () => {
    const open = b.getAttribute('aria-expanded') !== 'true';
    document.querySelectorAll<HTMLButtonElement>('[data-ps-round]').forEach((x) => { x.setAttribute('aria-expanded', 'false'); const p = document.getElementById(x.getAttribute('aria-controls')!); if (p) p.hidden = true; });
    if (open) { b.setAttribute('aria-expanded', 'true'); const p = document.getElementById(b.getAttribute('aria-controls')!); if (p) p.hidden = false; }
  }));
</script>
