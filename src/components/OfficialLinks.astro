---
// 바닥글 'KBO·구단 공식 채널' — config/teams.yaml 에서 확인한 주소만(값이 null 이면 빠진다)
import { LEAGUE, TEAMS, teamColor } from '../lib/site.ts';
const rows = [{ id: 'kbo', name: LEAGUE.name, website: LEAGUE.website, youtube: LEAGUE.youtube, instagram: LEAGUE.instagram }, ...TEAMS];
---
<section class="official-links" aria-labelledby="h-official">
  <h2 id="h-official">KBO·구단 공식 채널</h2>
  <ul class="official-grid">
    {rows.map((r) => (
      <li class="official-row">
        <span class="official-name"><span class="team-dot" style={`background:${r.id === 'kbo' ? 'var(--ink)' : teamColor(r.id)}`} aria-hidden="true"></span>{r.name}</span>
        <span class="official-icons">
          {r.website && <a href={r.website} target="_blank" rel="noopener noreferrer" aria-label={`${r.name} 공식 웹사이트`} title="웹사이트"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.6 2.8 3.9 5.8 3.9 9s-1.3 6.2-3.9 9c-2.6-2.8-3.9-5.8-3.9-9S9.4 5.8 12 3z" /></svg></a>}
          {r.youtube && <a href={r.youtube} target="_blank" rel="noopener noreferrer" aria-label={`${r.name} 공식 YouTube`} title="YouTube"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="5.5" width="19" height="13" rx="4" /><path d="M10 9.2v5.6l4.8-2.8z" class="dot" /></svg></a>}
          {r.instagram && <a href={r.instagram} target="_blank" rel="noopener noreferrer" aria-label={`${r.name} 공식 Instagram`} title="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.3" cy="6.7" r="1" class="dot" /></svg></a>}
        </span>
      </li>
    ))}
  </ul>
</section>
