---
// 지난 호 / 다음 호 — 맨 위와 맨 아래
import { issueLabel, periodLabel } from '../lib/site.ts';
import type { Issue } from '../lib/schemas.ts';
interface Props { issue: Issue; issues: Issue[]; where: 'top' | 'bottom' }
const { issue, issues, where } = Astro.props;
const i = issues.findIndex((x) => x.vol === issue.vol); // issues 는 최신 호가 앞
const older = i >= 0 ? issues[i + 1] : undefined;
const newer = i > 0 ? issues[i - 1] : undefined;
---
<nav class={`issue-nav issue-nav--${where}`} aria-label={where === 'top' ? '호 넘겨 보기' : '호 넘겨 보기(아래)'} data-pagefind-ignore>
  {older ? (
    <a class="issue-nav-link" href={`/issues/${older.vol}`} rel="prev"><span class="issue-nav-dir">← 지난 호</span><span class="issue-nav-label">{issueLabel(older.vol)}</span><span class="issue-nav-period">{periodLabel(older.period_start, older.period_end)}</span></a>
  ) : <span class="issue-nav-link is-empty"><span class="issue-nav-dir">첫 호입니다</span></span>}
  <a class="issue-nav-all" href="/archive">전체 호</a>
  {newer ? (
    <a class="issue-nav-link issue-nav-next" href={`/issues/${newer.vol}`} rel="next"><span class="issue-nav-dir">다음 호 →</span><span class="issue-nav-label">{issueLabel(newer.vol)}</span><span class="issue-nav-period">{periodLabel(newer.period_start, newer.period_end)}</span></a>
  ) : <span class="issue-nav-link issue-nav-next is-empty"><span class="issue-nav-dir">최신 호입니다</span></span>}
</nav>
