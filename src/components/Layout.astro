---
import '../styles/global.css';
import '../styles/magazine.css';
import '../styles/apple.css';
import '../styles/soft.css';
import OfficialLinks from './OfficialLinks.astro';
import TeamPickChip from './TeamPickChip.astro';
import Analytics from '@vercel/analytics/astro';
import { siteLayout, articleModal, brandLogo, revisit } from '../lib/config.ts';
import { SITE_NAME, TEAMS, teamColor, loadAll, BUILD_TIME } from '../lib/site.ts';
interface Props { title?: string; description?: string; sample?: boolean; searchable?: boolean; image?: string }
// searchable=false: 같은 내용이 호 페이지에 있어 검색 결과가 겹치는 페이지(메인)는 색인에서 뺀다
const { title, description = 'KBO 10개 구단 팀별 소식을 매일·매주 모아 요약하는 팬 매거진', sample = false, searchable = true, image = '/og/league.png' } = Astro.props;
// 공유 미리보기(카카오톡·페이스북·X)와 검색엔진용 주소·이미지 — 미리보기 이미지는 scripts/og.py 로 만든다
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
// 방문 측정: Vercel Web Analytics(쿠키 없음, @vercel/analytics 의 Astro 컴포넌트 — Routes 탭에 /teams/[id] 처럼 묶여 보인다). Vercel 빌드에서만 넣는다 — 되돌리기: 환경변수 SITE_ANALYTICS=false
const analytics = !!process.env.VERCEL && process.env.SITE_ANALYTICS !== 'false';
const full = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME} 빠따닷컴`;
// [주소, 이름, 휴대폰용 짧은 이름]. 휴대폰 머리말은 알약 2개만 들어간다(응원가 · 게임). 휴대폰 '게임'은 /games/ 고르기 화면, PC는 두 게임 알약을 따로
const nav = [['/cheer', '선수응원가 연습', '응원가'], ['/games/', '게임', '게임'], ['/game/', '매니저 게임', ''], ['/game/arcade/', '아케이드 야구', ''], ['/about', '소개', '']];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const layout = siteLayout();
const modal = articleModal(); // config/site.yaml article_modal (환경변수 SITE_MODAL 우선) // config/site.yaml layout (환경변수 SITE_LAYOUT 우선)
// 내 팀 전용 블록은 CSS 로 미리 보이게 해서 화면이 깜빡이지 않게 한다
// 내 팀 타일은 '10개 구단 한눈에'에서 맨 앞으로
// 지난 방문 이후 새 소식(revisit): 최근 3일 요약 글의 주소 → [수집 시각, 팀]. 방문 시각은 이 기기 localStorage 에만
const freshMap = revisit() ? Object.fromEntries((await loadAll()).signals.filter((x) => x.summary_ko && Date.parse(x.collected_at) > BUILD_TIME - 3 * 86400_000).map((x) => [x.url, [Date.parse(x.collected_at), x.teams.join(' ')]])) : null;
const myTeamCss = TEAMS.map((t) => `html[data-my-team="${t.id}"] [data-myteam-block="${t.id}"]{display:block}html[data-my-team="${t.id}"] [data-team-tile="${t.id}"]{order:-1;box-shadow:0 0 0 2px var(--ink)}`).join('');
---
<!doctype html>
{/* apple 은 magazine 위에 덧입힌다 — 규칙은 모두 .layout-apple 아래(src/styles/apple.css) */}
<html lang="ko" class={layout === 'soft' ? 'layout-magazine layout-apple layout-soft' : layout === 'apple' ? 'layout-magazine layout-apple' : `layout-${layout}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BBADDA 빠따닷컴" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap.xml" />
    {path === '/' && <script type="application/ld+json" is:inline set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', name: 'BBADDA 빠따닷컴', url: Astro.site?.href, inLanguage: 'ko', potentialAction: { '@type': 'SearchAction', target: `${Astro.site?.href}search/?q={q}`, 'query-input': 'required name=q' } })}></script>}
    <link rel="icon" href="/favicon.png" type="image/png" sizes="48x48" />
    {/* 홈 화면 추가(앱처럼 열기) — 아이콘은 scripts/og.py 로 만든다 */}
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#ECEFF4" />
    <meta name="apple-mobile-web-app-title" content="빠따닷컴" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="preload" href="/fonts/pretendard/PretendardVariable.subset.woff2" as="font" type="font/woff2" crossorigin />
    {/* 내 팀(localStorage)을 가장 먼저 읽어 html 에 표시. 저장소가 막혀 있으면 기본 화면 */}
    <script is:inline>try { var t = localStorage.getItem('bbadda:myTeam'); if (t && /^[a-z]+$/.test(t)) document.documentElement.dataset.myTeam = t; } catch (e) {}</script>
    <style is:inline set:html={`[data-myteam-block]{display:none}${myTeamCss}html[data-my-team] [data-no-team]{display:none}`}></style>
  </head>
  <body>
    <a class="skip" href="#main">본문으로 건너뛰기</a>
    {sample && <div class="sample-banner">SAMPLE — 화면 확인용 가상 데이터입니다. 실제 기사·사실이 아닙니다.</div>}
    <header class="site-header" data-pagefind-ignore>
      <div class="wrap">
        {brandLogo()
          ? <a class="brand brand--logo" href="/" aria-label="BBADDA 빠따닷컴 홈"><img src="/brand/bbadda-logo.webp" alt="BBADDA 빠따닷컴" width="267" height="96" /></a>
          : <a class="brand" href="/">BBADDA<span>.com</span></a>}
        <form class="header-search" action="/search/" method="get" role="search" aria-label="사이트 검색">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 21 21" /></svg>
          <input type="search" name="q" placeholder="팀·선수·키워드 검색" aria-label="검색어" autocomplete="off" />
          <a class="header-search-mobile" href="/search/" aria-label="검색"></a>
        </form>
        <div class="myteam">
          <button type="button" class="myteam-btn" data-myteam-toggle aria-expanded="false" aria-controls="myteam-panel">
            <span class="team-dot" data-myteam-dot aria-hidden="true"></span><span data-myteam-label>MY팀 고르기</span>{freshMap && <span class="mt-new" data-myteam-new hidden></span>}
          </button>
          <div class="myteam-panel" id="myteam-panel" hidden>
            <p class="small">MY팀을 고르면 그 팀 소식이 맨 위에 옵니다. 이 기기에만 저장됩니다.</p>
            <div class="team-picker-chips">
              {TEAMS.map((t) => <TeamPickChip t={t} />)}
            </div>
            <button type="button" class="link-btn" data-pick-team="">선택 해제</button>
          </div>
        </div>
        <nav class="nav" aria-label="주 메뉴">
          {nav.map(([href, label, short]) => <a href={href} class={href === '/cheer' ? 'nav-cheer' : href === '/games/' ? 'nav-cheer nav-game nav-m' : href === '/game/' ? 'nav-cheer nav-game nav-pc' : href === '/game/arcade/' ? 'nav-cheer nav-arcade nav-pc' : undefined} aria-label={short ? label : undefined} aria-current={path === href.replace(/\/$/, '') || (href !== '/' && href !== '/game/' && path.startsWith(href.replace(/\/$/, ''))) ? 'page' : undefined}>{href === '/cheer' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>}{(href === '/game/' || href === '/games/') && <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M7.5 5.5c2 2 2 11 0 13M16.5 5.5c-2 2-2 11 0 13"/></svg>}{href === '/game/arcade/' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="7" width="18" height="11" rx="3"/><path d="M8 10.5v4M6 12.5h4"/><circle cx="15.5" cy="12" r="1"/><circle cx="18" cy="14" r="1"/></svg>}{short ? <><span class="lbl-full">{label}</span><span class="lbl-short">{short}</span></> : label}</a>)}
        </nav>
      </div>
    </header>
    <main id="main" data-pagefind-body={searchable ? '' : undefined}>
      <div class="wrap"><slot /></div>
    </main>
    <footer class="site-footer" data-pagefind-ignore>
      <div class="wrap">
        <OfficialLinks />
        <div><strong>BBADDA 빠따닷컴</strong> — KBO 팬 매거진. KBO·각 구단과 관계없는 팬 사이트입니다.</div>
        <div>기사·게시물 본문과 사진 파일은 저장하지 않습니다(뉴스 사진은 원 매체 주소에서 표시). 요약은 편집자가 쓰고 모든 항목은 원문 링크로 연결됩니다. 구단 로고·엠블럼은 쓰지 않습니다.</div>
      </div>
    </footer>
    <button type="button" class="to-top" id="to-top" aria-label="맨 위로" hidden>↑</button>
    <aside class="install-nudge" id="install-nudge" hidden data-pagefind-ignore>
      <p class="in-text"><strong>앱처럼 쓰기</strong> <span class="in-how"></span></p>
      <button type="button" class="in-go" hidden>설치</button>
      <button type="button" class="in-close" aria-label="닫기">✕</button>
    </aside>
    {modal.on && (
      <dialog class="article-modal" id="article-modal" aria-label="기사 보기" data-blocked={JSON.stringify(modal.blocked)} data-blocked-open={modal.blockedOpen} data-pagefind-ignore>
        <div class="am-bar">
          <span class="am-src"></span>
          <span class="am-title"></span>
          <a class="am-open" href="#" target="_blank" rel="noopener noreferrer">원문 새 창으로</a>
          <button type="button" class="am-close" aria-label="닫기">✕</button>
        </div>
        <p class="am-loading" aria-live="polite">원문을 불러오는 중…</p>
        <iframe class="am-frame" title="원문" sandbox="allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox allow-forms allow-presentation" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" referrerpolicy="strict-origin-when-cross-origin"></iframe>
        <div class="am-fallback" hidden>
          <p class="am-fb-title"></p>
          <p class="am-fb-note">이 매체는 다른 사이트 안에서 기사를 열 수 없게 막아 두었습니다.</p>
          <a class="am-fb-open" href="#" target="_blank" rel="noopener noreferrer">원문 보기</a>
        </div>
      </dialog>
    )}
    {modal.on && (
      <script>
        // 기사 모달: 본문 영역의 바깥 링크(새 탭 링크)를 누르면 모달 브라우저로 연다. Ctrl·Cmd·가운데 클릭은 그대로 새 탭.
        const dlg = document.getElementById('article-modal') as HTMLDialogElement | null;
        if (dlg) {
          const blocked: string[] = JSON.parse(dlg.dataset.blocked || '[]');
          const blockedOpen = dlg.dataset.blockedOpen || 'modal';
          // 읽은 기사 표시(이 브라우저에만 저장)
          const READ_KEY = 'bbadda:read';
          let read: string[] = [];
          try { read = JSON.parse(localStorage.getItem(READ_KEY) || '[]'); if (!Array.isArray(read)) read = []; } catch { read = []; }
          const cardOf = (a: Element) => a.closest<HTMLElement>('[data-card], li');
          // 제목 글자 링크에만 '읽음 ✓' 칩을 붙인다(사진·썸네일 링크, 가을야구 출처 링크 제외)
          const titleLink = (a: HTMLAnchorElement) => !a.matches('[tabindex="-1"]') && !a.querySelector('img') && !a.closest('.ps-block') && a.textContent!.trim().length > 0;
          const flag = (href: string) => document.querySelectorAll<HTMLAnchorElement>('main a[target="_blank"]').forEach((x) => { if (x.href === href && titleLink(x)) x.classList.add('read-link'); });
          const markRead = (a: HTMLAnchorElement) => {
            cardOf(a)?.classList.add('is-read'); flag(a.href);
            if (!read.includes(a.href)) { read = [a.href, ...read].slice(0, 500); try { localStorage.setItem(READ_KEY, JSON.stringify(read)); } catch {} }
          };
          const done = new Set(read);
          document.querySelectorAll<HTMLAnchorElement>('main a[target="_blank"]').forEach((a) => { if (done.has(a.href)) { cardOf(a)?.classList.add('is-read'); if (titleLink(a)) a.classList.add('read-link'); } });
          const frame = dlg.querySelector<HTMLIFrameElement>('.am-frame')!;
          const fb = dlg.querySelector<HTMLElement>('.am-fallback')!;
          const opens = dlg.querySelectorAll<HTMLAnchorElement>('.am-open, .am-fb-open');
          let opener: HTMLElement | null = null;
          const embedOf = (u: URL): string | null => {
            const h = u.hostname.replace(/^(www|m)\./, '');
            if (h === 'youtube.com' || h === 'youtu.be') {
              const id = h === 'youtu.be' ? u.pathname.slice(1) : u.searchParams.get('v') || (/\/shorts\/([\w-]{11})/.exec(u.pathname) || [])[1];
              return id ? `https://www.youtube-nocookie.com/embed/${id}?autoplay=1` : null;
            }
            if (h === 'instagram.com') { const m = /^\/(p|reel)\/([\w-]+)/.exec(u.pathname); return m ? `https://www.instagram.com/${m[1]}/${m[2]}/embed` : null; }
            if (blocked.includes('*') || blocked.some((b) => h === b || h.endsWith('.' + b))) return null; // '*' = 모든 기사 사이트를 우리 페이지 안에 띄우지 않음
            if (u.protocol !== 'https:') return null; // http 주소는 https 사이트 안에 띄울 수 없다
            return u.href;
          };
          const open = (a: HTMLAnchorElement) => {
            const u = new URL(a.href);
            const title = (a.closest('[data-card], li')?.querySelector('h3, .headline-title, a:not([tabindex="-1"])')?.textContent || a.textContent || '').trim();
            dlg.querySelector('.am-src')!.textContent = u.hostname.replace(/^www\./, '');
            dlg.querySelector('.am-title')!.textContent = title;
            dlg.querySelector('.am-fb-title')!.textContent = title;
            opens.forEach((o) => (o.href = a.href));
            const src = embedOf(u);
            frame.hidden = !src; fb.hidden = !!src;
            dlg.classList.toggle('is-loading', !!src);
            frame.src = src ?? 'about:blank';
            opener = a;
            dlg.showModal();
            document.documentElement.classList.add('modal-open');
          };
          frame.addEventListener('load', () => { if (frame.src !== 'about:blank') dlg.classList.remove('is-loading'); });
          const close = () => { dlg.close(); };
          dlg.addEventListener('close', () => { frame.src = 'about:blank'; document.documentElement.classList.remove('modal-open'); opener?.focus(); });
          dlg.querySelector('.am-close')!.addEventListener('click', close);
          dlg.addEventListener('click', (e) => { if (e.target === dlg) close(); }); // 흐린 바깥 누르면 닫기
          document.addEventListener('click', (e) => {
            if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            const a = (e.target as Element).closest<HTMLAnchorElement>('main a[target="_blank"]');
            if (!a || a.closest('[data-no-modal], .team-hero-actions') || !/^https?:/.test(a.href) || new URL(a.href).host === location.host) return;
            e.preventDefault();
            markRead(a);
            const u = new URL(a.href);
            if (!embedOf(u) && blockedOpen !== 'modal' && !/youtube|youtu\.be|instagram/.test(u.hostname)) {
              // 모달에 못 띄우는 매체: PC 는 작은 창(닫으면 바로 이 화면), 모바일은 같은 탭(뒤로가기로 돌아옴), 팝업 차단은 새 탭
              const desktop = matchMedia('(min-width: 900px) and (pointer: fine)').matches;
              if (blockedOpen === 'same' || (blockedOpen === 'window' && !desktop)) { location.assign(a.href); return; }
              const small = blockedOpen === 'window' && desktop;
              // noopener 를 features 에 넣으면 window.open 이 항상 null 을 돌려줘 '팝업이 막혔다'로 오인되고 새 탭이 또 열린다 — 열린 뒤 opener 만 끊는다
              const w = small ? window.open(a.href, 'bbadda-article', `popup=yes,width=1040,height=820,left=${Math.max(0, screenX + 80)},top=${Math.max(0, screenY + 60)}`) : null;
              if (w) { try { w.opener = null; } catch {} w.focus(); }
              else window.open(a.href, '_blank', 'noopener,noreferrer');
              return;
            }
            open(a);
          });
        }
      </script>
    )}
    <script>
      // 맨 위로 버튼: 많이 내려왔을 때만 나온다(CSS 로 모바일·태블릿에서만 보임)
      const toTop = document.getElementById('to-top');
      if (toTop) {
        addEventListener('scroll', () => { toTop.hidden = scrollY < 900; }, { passive: true });
        toTop.addEventListener('click', () => scrollTo({ top: 0, behavior: 'smooth' }));
      }
    </script>
    <script>
      // 홈 화면 설치 안내(모바일): 기사를 한 번이라도 읽고 돌아온 사람에게만, 한 번 닫으면 다시 안 띄운다. 설치한 앱은 외부 기사를 닫기 버튼이 있는 앱 안 브라우저로 여는 경우가 많다.
      const nudge = document.getElementById('install-nudge');
      if (nudge) {
        const NK = 'bbadda:install-nudge';
        const mobile = matchMedia('(max-width: 899px)').matches || matchMedia('(pointer: coarse)').matches;
        const standalone = matchMedia('(display-mode: standalone)').matches || (navigator as unknown as { standalone?: boolean }).standalone === true;
        let dismissed = false, hasRead = false;
        try { dismissed = localStorage.getItem(NK) === 'x'; hasRead = JSON.parse(localStorage.getItem('bbadda:read') || '[]').length > 0; } catch {}
        if (mobile && !standalone && !dismissed && hasRead) {
          const how = nudge.querySelector<HTMLElement>('.in-how')!;
          const go = nudge.querySelector<HTMLButtonElement>('.in-go')!;
          const ios = /iphone|ipad|ipod/i.test(navigator.userAgent);
          how.textContent = ios ? '공유 버튼 → "홈 화면에 추가"를 누르면 앱처럼 열립니다.' : '메뉴 → "홈 화면에 추가"로 앱처럼 열 수 있습니다.';
          let deferred: (Event & { prompt: () => void }) | null = null;
          window.addEventListener('beforeinstallprompt', (e) => { e.preventDefault(); deferred = e as Event & { prompt: () => void }; how.textContent = '홈 화면에 설치하면 앱처럼 열립니다.'; go.hidden = false; });
          go.addEventListener('click', () => { deferred?.prompt(); nudge.hidden = true; });
          nudge.querySelector('.in-close')!.addEventListener('click', () => { nudge.hidden = true; try { localStorage.setItem(NK, 'x'); } catch {} });
          nudge.hidden = false;
        }
      }
    </script>
    <script>
      // 내 팀 선택: localStorage 저장(try/catch), 머리말 칩 갱신, [data-team-sort] 안의 팀 섹션을 내 팀이 맨 위·펼침, 나머지는 접힘
      const KEY = 'bbadda:myTeam';
      const html = document.documentElement;
      const btns = [...document.querySelectorAll<HTMLButtonElement>('[data-pick-team]')];
      const label = document.querySelector<HTMLElement>('[data-myteam-label]');
      const dot = document.querySelector<HTMLElement>('[data-myteam-dot]');
      const toggle = document.querySelector<HTMLButtonElement>('[data-myteam-toggle]');
      const panel = document.getElementById('myteam-panel');
      const apply = (id: string) => {
        const b = btns.find((x) => x.dataset.pickTeam === id && id);
        if (b) html.dataset.myTeam = id; else delete html.dataset.myTeam;
        // 넓은 화면은 'MY팀 · 갈매기', 휴대폰은 '갈매기'(애칭). 점 자리에 구단 로고
        if (label) {
          const long = document.createElement('span'); long.className = 'mt-long'; long.textContent = b ? `MY팀 · ${b.dataset.nick ?? b.dataset.short}` : 'MY팀 고르기';
          const short = document.createElement('span'); short.className = 'mt-short'; short.textContent = b ? (b.dataset.nick ?? b.dataset.short ?? '') : 'MY팀';
          label.replaceChildren(long, short);
        }
        if (dot) {
          dot.classList.toggle('has-logo-dot', !!b?.dataset.logo);
          dot.style.background = b?.dataset.logo ? `url("${b.dataset.logo}") center / 100% no-repeat` : b?.dataset.color ?? 'transparent';
        }
        btns.forEach((x) => x.setAttribute('aria-pressed', String(!!id && x.dataset.pickTeam === id)));
        document.querySelectorAll<HTMLElement>('[data-team-sort]').forEach((box) => {
          const mine = box.querySelector<HTMLElement>(`:scope > [data-team-section="${id}"]`);
          if (mine && b) box.prepend(mine);
          box.querySelectorAll<HTMLDetailsElement>(':scope > details[data-team-section]').forEach((d) => {
            d.open = b ? d.dataset.teamSection === id : d.hasAttribute('data-open-default');
            d.classList.toggle('is-mine', !!b && d.dataset.teamSection === id);
          });
        });
      };
      let saved = '';
      try { saved = localStorage.getItem(KEY) ?? ''; } catch {}
      apply(saved);
      // #team-<id> 로 들어오면 그 팀 섹션을 펼친다(팀 페이지의 '지난 호에서' 링크)
      const openHash = () => { const d = document.getElementById(location.hash.slice(1)); if (d instanceof HTMLDetailsElement) { d.open = true; d.scrollIntoView(); } };
      if (location.hash.startsWith('#team-')) openHash();
      addEventListener('hashchange', openHash);
      btns.forEach((b) => b.addEventListener('click', () => {
        const id = b.dataset.pickTeam ?? '';
        try { if (id) localStorage.setItem(KEY, id); else localStorage.removeItem(KEY); } catch {}
        apply(id);
        if (panel && toggle) { panel.hidden = true; toggle.setAttribute('aria-expanded', 'false'); }
      }));
      toggle?.addEventListener('click', () => {
        if (!panel) return;
        panel.hidden = !panel.hidden;
        toggle.setAttribute('aria-expanded', String(!panel.hidden));
      });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && panel && !panel.hidden) { panel.hidden = true; toggle?.setAttribute('aria-expanded', 'false'); toggle?.focus(); } });
      document.addEventListener('click', (e) => { if (panel && !panel.hidden && !(e.target as Element).closest('.myteam')) { panel.hidden = true; toggle?.setAttribute('aria-expanded', 'false'); } });
    </script>
    <script>
      document.querySelectorAll<HTMLButtonElement>('[data-share]').forEach((b) => b.addEventListener('click', async () => {
        const data = { title: document.title, url: location.href.split('#')[0] };
        try {
          if (navigator.share) return await navigator.share(data);
          await navigator.clipboard.writeText(data.url);
          const label = b.querySelector('span'); const old = label?.textContent;
          if (label) { label.textContent = '주소 복사됨'; setTimeout(() => (label.textContent = old ?? '공유'), 1600); }
        } catch {}
      }));
    </script>
    {freshMap && <script type="application/json" id="fresh-map" set:html={JSON.stringify(freshMap)} />}
    <script>
      // 지난 방문 이후 새 소식: 이번 방문의 기준 시각은 탭을 닫을 때까지 유지(sessionStorage), 다음 방문용 시각은 매번 갱신. 첫 방문은 표시 없음
      const src = document.getElementById('fresh-map');
      if (src) {
        const map = JSON.parse(src.textContent ?? '{}') as Record<string, [number, string]>;
        let base = 0;
        try {
          let b = sessionStorage.getItem('bbadda:base');
          if (b === null) { b = localStorage.getItem('bbadda:lastSeen') ?? ''; sessionStorage.setItem('bbadda:base', b); }
          localStorage.setItem('bbadda:lastSeen', String(Date.now()));
          base = Number(b) || 0;
        } catch {}
        const fresh = base ? Object.keys(map).filter((u) => map[u][0] > base) : [];
        if (fresh.length) {
          const set = new Set(fresh);
          document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((a) => { if (set.has(a.getAttribute('href') ?? '') && a.tabIndex !== -1 && a.textContent?.trim()) a.classList.add('is-fresh'); });
          document.querySelectorAll<HTMLElement>('[data-fresh-count]').forEach((el) => { el.textContent = `지난 방문 이후 새 소식 ${fresh.length}개`; el.hidden = false; });
          const my = document.documentElement.dataset.myTeam;
          const n = my ? fresh.filter((u) => map[u][1].split(' ').includes(my)).length : 0;
          const bubble = document.querySelector<HTMLElement>('[data-myteam-new]');
          if (bubble && n) { bubble.textContent = String(n); bubble.title = `MY팀 새 소식 ${n}개`; bubble.hidden = false; }
        }
      }
    </script>
    {analytics && <Analytics />}
  </body>
</html>
